<section class="card db-panel" id="database-panel" aria-label="Base disponible">
  <div class="db-head">
    <h2 class="db-title"><span class="material-symbols-rounded text-primary" aria-hidden="true">database</span>Base
      disponible</h2>
    <span class="badge badge-meta badge-sm">
      <%= tables.length %> table<%= tables.length>1?'s':'' %>
    </span>
  </div>
  <div class="accordion db-accordion">
    <% tables.forEach((t,i)=>{ const open=i===openIndex; %>
      <div class="accordion-item <%= open?'active':'' %>" id="db-item-<%= i %>">
        <button type="button" class="accordion-toggle db-toggle" aria-controls="db-content-<%= i %>"
          aria-expanded="<%= open %>">
          <span class="material-symbols-rounded db-chevron accordion-item-active:rotate-90"
            aria-hidden="true">chevron_right</span>
          <code class="db-table"><%= t.name %></code>
          <span class="db-count">
            <%= t.rows.length %> ligne<%= t.rows.length>1?'s':'' %> · <%= t.columns.length %> colonne<%=
                    t.columns.length>1?'s':'' %>
          </span>
        </button>
        <div id="db-content-<%= i %>"
          class="accordion-content w-full overflow-hidden transition-[height] duration-300 <%= open?'':'hidden' %>"
          role="region" aria-labelledby="db-item-<%= i %>">
          <nav class="tabs tabs-bordered db-tabs" role="tablist" aria-label="Explorer <%= t.name %>"
            aria-orientation="horizontal">
            <button type="button" class="tab active-tab:tab-active active" id="db-data-tab-<%= i %>"
              data-tab="#db-data-<%= i %>" aria-controls="db-data-<%= i %>" role="tab"
              aria-selected="true">Données</button>
            <button type="button" class="tab active-tab:tab-active" id="db-schema-tab-<%= i %>"
              data-tab="#db-schema-<%= i %>" aria-controls="db-schema-<%= i %>" role="tab"
              aria-selected="false">Structure</button>
          </nav>
          <div id="db-data-<%= i %>" role="tabpanel" aria-labelledby="db-data-tab-<%= i %>" tabindex="0">
            <%- include('sql-table',{columns:t.columns.map(c=>({name:c.name,pk:c.pk})),rows:t.rows,caption:'Données initiales de '+t.name,tall:true}) %>
          </div>
          <div id="db-schema-<%= i %>" class="hidden" role="tabpanel" aria-labelledby="db-schema-tab-<%= i %>"
            tabindex="0">
            <% const structure=t.columns.map(c=>{
              const fk=t.foreignKeys?.find(f=>f.from===c.name);
              const rules=[c.pk?'PRIMARY KEY':null,c.notnull&&!c.pk?'NOT NULL':null,c.default!==null&&c.default!==undefined?'DEFAULT '+c.default:null,fk?'→'+fk.table+'('+fk.to+')':null].filter(Boolean);
              return [c.name,c.type||'—',rules.length?rules.join(' · '):'—'];
              });
              %>
              <%- include('sql-table',{columns:['colonne','type','contraintes'],rows:structure,caption:'Structure de '+t.name,tall:true}) %>
        </div>
      </div>
    </div>
    <% }) %>
  </div>
</section>
<%- include('partials/start') %>
  <% const isSprint=run.mode==='sprint' ; const total=details.length; %>
    <p class="eyebrow mb-3">
      <%= isSprint?'Sprint terminé':'Retour du jury' %>
    </p>
    <h1>
      <%= stats.firstTry===total?'Bien joué, tout est juste du premier coup !':'Chaque essai te fait avancer.' %>
    </h1>
    <% if(isSprint){ %>
      <div class="sprint-score">
        <div class="sprint-score-main">
          <span class="sprint-score-value">
            <%= stats.firstTry %> / <%= total %>
          </span>
          <span class="sprint-score-label">du premier coup</span>
        </div>
        <div class="sprint-score-side">
          <span><strong>
              <%= stats.resolved %> / <%= total %>
            </strong> résolues</span>
          <span><strong>
              <%= stats.attempts %>
            </strong> tentative<%= stats.attempts>1?'s':'' %></span>
          <span><strong>
              <%= Math.floor(duration/60) %> min <%= duration%60 %> s
            </strong></span>
        </div>
      </div>
      <% } else { %>
        <div class="metric-grid !grid-cols-2 sm:!grid-cols-4">
          <% for(const [label,value] of [['Score',score+' / '+total],[' Bonnes réponses',score],['À revoir',total-score],['Temps',Math.floor(duration/60)+' min '+duration%60+' s']]){ %>
            <div class="stats">
              <div class="stat">
                <div class="stat-title">
                  <%= label %>
                </div>
                <div class="stat-value">
                  <%= value %>
                </div>
              </div>
            </div>
            <% } %>
        </div>
        <% } %>
          <% if(weak.length){ %>
            <div class="alert alert-soft alert-warning mb-6">
              <div>
                <h2 class="text-sm mb-2">Les notions à reprendre</h2>
                <div class="flex flex-wrap gap-2">
                  <% for(const tag of weak){ %><span class="badge badge-soft badge-warning">
                      <%= tag %>
                    </span>
                    <% } %>
                </div>
              </div>
            </div>
            <% } %>
              <div class="space-y-4">
                <% for(const [i,a] of details.entries()){ const first=a.firstAttemptCorrect??a.correct; const
                  solved=a.resolved??a.correct; %>
                  <section class="card border border-base-300 shadow-none">
                    <div class="card-body">
                      <div class="flex flex-wrap gap-3 justify-between">
                        <h2 class="text-base">
                          <%= i+1 %>. <%= a.exercise.title %>
                        </h2>
                        <div class="flex flex-wrap gap-2 items-center">
                          <% if(isSprint&&a.attemptCount){ %><span class="badge badge-meta badge-sm">
                              <%= a.attemptCount %> tentative<%= a.attemptCount>1?'s':'' %>
                            </span>
                            <% } %><span
                                class="badge badge-soft <%= first?'badge-success':solved?'badge-primary':'badge-warning' %>">
                                <%= a.skipped?'Passée':first?'Du premier coup':solved?'Résolue':'À revoir' %>
                              </span>
                        </div>
                      </div>
                      <p class="text-sm muted mt-2">
                        <%= a.exercise.statement %>
                      </p>
                      <div class="grid md:grid-cols-2 gap-4 mt-4">
                        <div>
                          <h3 class="text-xs mb-2">Ta réponse</h3>
                          <pre class="bg-base-200 p-4 rounded-lg text-xs"><%= a.query %></pre>
                          <% if(a.result.error){ %>
                            <p class="text-error text-xs mt-2">
                              <%= a.result.error %>
                            </p>
                            <% } %>
                        </div>
                        <div>
                          <h3 class="text-xs mb-2">Une correction possible</h3>
                          <pre class="bg-base-200 p-4 rounded-lg text-xs"><%= a.exercise.solutionSql %></pre>
                        </div>
                      </div>
                      <p class="text-sm muted mt-3">
                        <%= a.exercise.notion %>
                      </p><a class="link link-primary text-sm font-bold mt-3"
                        href="/training/<%= a.exercise.id %>">Reprendre cet exercice avec les indices ↗</a>
                    </div>
                  </section>
                  <% } %>
              </div>
              <div class="flex flex-wrap gap-3 mt-6">
                <form method="post" action="/<%= run.mode %>/start"><input type="hidden" name="_csrf"
                    value="<%= csrf %>"><input type="hidden" name="count" value="<%= total %>"><button
                    class="btn btn-primary">
                    <%= isSprint?'Nouveau sprint':'Question suivante' %><span class="material-symbols-rounded"
                        aria-hidden="true">arrow_forward</span>
                  </button></form><a href="/dashboard" class="btn btn-outline">Tableau de bord</a>
              </div>
              <%- include('partials/end') %>